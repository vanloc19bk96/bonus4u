// Cloudflare Worker that only serves static files from dist/ (no server code).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bonus4u",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // /app → /app/ and /app/index.html → /app/, so each app has one clean URL.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "bonus4u.fastaifactory.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
